{
  "name": "dpzvc3",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev:vue": "pnpm --filter @dpzvc3/vue dev",
    "build:vue": "pnpm --filter @dpzvc3/vue build",
    "build:react": "pnpm --filter @dpzvc3/react build",
    "preview:vue": "pnpm --filter @dpzvc3/views-vue dev",
    "preview:react": "pnpm --filter @dpzvc3/views-react dev",
    "build:vuessr": "pnpm --filter @dpzvc3/views-vue build:ssr",
    "lint": "pnpm -r lint",
    "type-check": "pnpm -r type-check",
    "build": "pnpm --filter @dpzvc3/views-vue build:ssr",
    "start": "pnpm --filter @dpzvc3/views-vue start",
    "vercel-build": "pnpm --filter @dpzvc3/views-vue build:ssr"
  },
  "devDependencies": {
    "@types/node": "^25.0.7",
    "eslint": "^9.39.2"
  }
}