{
  "name": "@dpzvc3/views-vue",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "fix": "eslint src --fix",
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "dev:ssr": "node server-dev.js",
    "build:ssr": "vite build --config vite.config.ssr.client.ts && vite build --config vite.config.ssr.server.ts && echo '==== dist-ssr ====' && ls -R dist-ssr",
    "start": "node server.cjs",
    "vercel-build": "pnpm --filter @dpzvc3/vue build && pnpm --filter @dpzvc3/styles build && pnpm build:ssr"
  },
  "dependencies": {
    "@dpzvc3/styles": "workspace:*",
    "@dpzvc3/vue": "workspace:*",
    "@vueuse/head": "^2.0.0",
    "express": "^5.2.1",
    "vue": "^3.5.24",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/server-renderer": "^3.5.26",
    "@vue/tsconfig": "^0.8.1",
    "element-plus": "^2.13.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^9.33.0",
    "postcss-pxtorem": "^6.1.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.53.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^31.0.0",
    "vite": "^7.2.4",
    "vite-plugin-eslint2": "^5.0.4",
    "vite-plugin-inspect": "^11.3.3",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.1.4"
  }
}
